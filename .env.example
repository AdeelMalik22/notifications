# Copy this file to .env for local Docker Compose development only.
# Replace every credential before using a non-local environment.

DJANGO_SETTINGS_MODULE=notifications.settings.local
DJANGO_SECRET_KEY=local-development-key-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=notifications
RABBITMQ_DEFAULT_PASS=local-rabbitmq-password
CELERY_BROKER_URL=amqp://notifications:local-rabbitmq-password@rabbitmq:5672//

REDIS_URL=redis://redis:6379/1

EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=notifications@example.test

SMS_PROVIDER_BACKEND=apps.delivery.providers.fake_sms.FakeSMSProvider
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=
CONTACT_ENCRYPTION_KEY=
CONTACT_LOOKUP_KEY=

WEB_PORT=8000
POSTGRES_FORWARD_PORT=5432
RABBITMQ_FORWARD_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_FORWARD_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
